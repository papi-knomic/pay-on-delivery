# Copy to .env and fill in. Never commit .env.

# --- Infrastructure (docker compose defaults) ---
# Use 127.0.0.1, not localhost: on Windows/WSL, localhost can resolve to ::1 and hit a different service.
DATABASE_URL=postgres://pod:pod@127.0.0.1:5432/pod
REDIS_URL=redis://127.0.0.1:6379

# --- PayPal (SANDBOX ONLY) ---
# developer.paypal.com > Apps & Credentials > (Sandbox) your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# developer.paypal.com > your app > Webhooks > the webhook's ID
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=SANDBOX

# --- AI (week 2) ---
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# --- App ---
# Public HTTPS origin (Cloudflare tunnel locally, your domain in prod). Used for PayPal return/cancel URLs.
PUBLIC_BASE_URL=http://localhost:3000
API_PORT=3000

# --- Frontend (baked in at BUILD time; pass as Docker build args) ---
VITE_AG_GRID_LICENSE_KEY=

# --- Smoke scripts only ---
# Email of a sandbox PERSONAL account (developer.paypal.com > Sandbox accounts)
SANDBOX_PAYOUT_RECEIVER_EMAIL=
